{
  "name": "hollowframe",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "node tests/browser-regression.mjs",
    "format": "prettier --write src tests index.html vite.config.js",
    "test:phase2": "node tests/phase2-browser.mjs",
    "test:phase3": "node tests/phase3-browser.mjs",
    "test:combat": "node tests/sustained-combat.mjs",
    "test:production": "node tests/production.mjs",
    "test:phase4": "node tests/phase4-browser.mjs",
    "test:profile": "node tests/render-profile.mjs",
    "test:release": "node tests/release-browser.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "check:format": "prettier --check src tests scripts index.html vite.config.js",
    "test:movement": "node tests/movement-browser.mjs",
    "test:terrain": "node tests/terrain-browser.mjs",
    "test:factions": "node tests/factions-browser.mjs",
    "test:aftershock": "node tests/aftershock-browser.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.8",
    "vite": "^7.1.0"
  }
}
